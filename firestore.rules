rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // True if the signed-in user created the poll the given vote belongs to.
    // Lets creators reset votes (read to find them, delete to remove them).
    function isPollCreator(pollId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/polls/$(pollId))
        && get(/databases/$(database)/documents/polls/$(pollId)).data.createdBy == request.auth.uid;
    }

    // ── Polls ────────────────────────────────────────────────────────────────
    match /polls/{pollId} {
      // Any poll is readable by anyone who knows its document ID.
      // "Private" means excluded from public listings (enforced in queries via
      // where('isPrivate', '==', false)), not blocked from direct access.
      // This is required so voters (including anonymous) can read the poll
      // document inside the castVote transaction before updating vote counts.
      allow read: if true;

      // Authenticated users may create polls (createdBy must match their uid).
      // Unauthenticated users may also create polls; createdBy must be null.
      // Custom polls are restricted to authenticated users in the app layer (CreateCustom.tsx).
      allow create: if (request.auth != null && request.resource.data.createdBy == request.auth.uid)
                    || (request.auth == null && request.resource.data.createdBy == null);

      // Allowed poll updates:
      // 1. Creator can change anything.
      // 2. Anyone can increment vote counts on an active poll (castVote transaction).
      // 3. Anyone can flip status to 'ended' once the poll has expired (client auto-expiry).
      allow update: if
        (request.auth != null && request.auth.uid == resource.data.createdBy)
        || (
          resource.data.status == 'active'
          && request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(['options', 'locations', 'timeSlots', 'totalVotes'])
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status == 'ended'
          && resource.data.endsAt < request.time
        );

      // Only the creator may delete their poll.
      allow delete: if request.auth != null && request.auth.uid == resource.data.createdBy;
    }

    // ── Votes ────────────────────────────────────────────────────────────────
    match /votes/{voteId} {
      // Voters read their own vote record (anonymous votes are unreadable); the poll creator may read votes of their poll to reset them.
      allow read: if (request.auth != null && request.auth.uid == resource.data.userId)
                  || isPollCreator(resource.data.pollId);

      // Authenticated users must match userId; anonymous users must set userId to null.
      allow create: if (request.auth != null && request.resource.data.userId == request.auth.uid)
                    || (request.auth == null && request.resource.data.userId == null);

      // Votes are immutable once cast (only deletable by the poll creator).
      allow update: if false;
      // Poll creator may delete votes when resetting them.
      allow delete: if isPollCreator(resource.data.pollId);
    }

    // ── Schedule votes ───────────────────────────────────────────────────────
    match /schedule_votes/{voteId} {
      allow read: if (request.auth != null && request.auth.uid == resource.data.userId)
                  || isPollCreator(resource.data.pollId);
      allow create: if (request.auth != null && request.resource.data.userId == request.auth.uid)
                    || (request.auth == null && request.resource.data.userId == null);
      allow update: if false;
      // Poll creator may delete votes when resetting them.
      allow delete: if isPollCreator(resource.data.pollId);
    }

    // ── Ranking votes ────────────────────────────────────────────────────────
    match /ranking_votes/{voteId} {
      allow read: if (request.auth != null && request.auth.uid == resource.data.userId)
                  || isPollCreator(resource.data.pollId);
      allow create: if (request.auth != null && request.resource.data.userId == request.auth.uid)
                    || (request.auth == null && request.resource.data.userId == null);
      allow update: if false;
      // Poll creator may delete votes when resetting them.
      allow delete: if isPollCreator(resource.data.pollId);
    }

    // ── Priority votes ───────────────────────────────────────────────────────
    match /priority_votes/{voteId} {
      allow read: if (request.auth != null && request.auth.uid == resource.data.userId)
                  || isPollCreator(resource.data.pollId);
      allow create: if (request.auth != null && request.resource.data.userId == request.auth.uid)
                    || (request.auth == null && request.resource.data.userId == null);
      allow update: if false;
      // Poll creator may delete votes when resetting them.
      allow delete: if isPollCreator(resource.data.pollId);
    }

    // ── Users ────────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Own profile: full read/write.
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Other authenticated users may read profiles for the email-lookup feature
      // (used when inviting contacts to polls). Sensitive fields like fcmToken are
      // stripped at the application layer in getUserByEmail().
      allow read: if request.auth != null;
    }

    // Contacts subcollection — only the owning user.
    match /users/{userId}/contacts/{contactId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Notifications ────────────────────────────────────────────────────────
    match /notifications/{userId}/items/{notifId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── FCM push queue ────────────────────────────────────────────────────────
    // Only authenticated clients may enqueue a push notification.
    // Reading, updating, and deleting is reserved for the Cloud Function (Admin SDK).
    match /push_queue/{docId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
